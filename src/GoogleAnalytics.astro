---
// component: src/components/common/GoogleAnalytics.astro
export interface Props {
	id: string;
	partytown?: boolean;
	domain?: string;
}

const { id, partytown = false, domain = "https://www.googletagmanager.com" } = Astro.props;

const attrs = partytown ? { type: "text/partytown" } : {};
---
<!-- Global site tag (gtag.js) - Google Analytics -->
{ id && (
  <script is:inline async src={`${domain}/gtag/js?id=${id}`} {...attrs}></script>
)}

{ id && (
  <script define:vars={{ id }} {...attrs}>
    // Initialize dataLayer and gtag
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
    };

    // Store current tracking ID on window for the after-swap listener
    window.__ga_tracking_id = id;

    // Send pageview on first load
    gtag('js', new Date());
    gtag('config', id);

    // Re-send pageview on view transitions (guard against duplicate listeners)
    if (!window.__ga_after_swap_added) {
      window.__ga_after_swap_added = true;
      document.addEventListener('astro:after-swap', () => {
        gtag('js', new Date());
        gtag('config', window.__ga_tracking_id);
      });
    }
  </script>
)}