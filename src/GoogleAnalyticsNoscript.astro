---
// component: src/components/common/GoogleAnalyticsNoscript.astro
export interface Props {
	id: string;
	domain?: string;
}

const { id, domain = "https://www.googletagmanager.com" } = Astro.props;
---

<!-- Google Analytics NoScript fallback -->{
  id && (
    <noscript>
      <iframe
        src={`${domain}/gtag/js?id=${id}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      />
    </noscript>
  )
}
